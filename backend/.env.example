# Supabase project settings. Use the publishable (or legacy anon) key only.
# Do not place a service-role key or a database password in this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# The Vite development server origin allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173