# Supabase project settings. Use the publishable (or legacy anon) key only.
# Do not place a service-role key or a database password in this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Exact browser origin allowed to call this API. Do not include a trailing slash.
# Production example: https://your-frontend-project.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Optional additional origin pattern. The default permits only this project's
# Vercel preview deployments; leave it unchanged unless the project URL changes.
FRONTEND_ORIGIN_REGEX=^https://a2-bus4012-myetfhub-[a-z0-9-]+-ngoc-giang\.vercel\.app$
